rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Default-deny for any unspecified paths
    match /{document=**} {
      allow read, write: if false;
    }

    // Personal library storage: users/{userId}/books/{bookId}
    // Restricts all read and write operations strictly to matheusreiserm@gmail.com
    match /users/{userId}/books/{bookId} {
      allow read, write: if request.auth != null
        && request.auth.uid == userId
        && request.auth.token.email == "matheusreiserm@gmail.com";
    }
  }
}
