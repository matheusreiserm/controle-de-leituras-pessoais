rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    match /{allPaths=**} {
      allow read, write: if false;
    }

    // Book covers: users/{userId}/covers/{hash}.webp, only for the owner account, images up to 2 MB
    match /users/{userId}/covers/{fileName} {
      allow read: if request.auth != null
        && request.auth.uid == userId
        && request.auth.token.email == "matheusreiserm@gmail.com";
      allow write: if request.auth != null
        && request.auth.uid == userId
        && request.auth.token.email == "matheusreiserm@gmail.com"
        && request.resource.size < 2 * 1024 * 1024
        && request.resource.contentType == 'image/webp';
    }
  }
}
